local lift = script.Parent
local prompt = lift:WaitForChild("ProximityPrompt")

local isMoving = false

prompt.Triggered:Connect(function(player)
	if isMoving then return end
	isMoving = true
	
	-- 발판을 위로 20칸 이동
	for i = 1, 20 do
		lift.Position = lift.Position + Vector3.new(0, 1, 0)
		task.wait(0.05)
	end
	
	task.wait(2) -- 정상에서 2초 대기
	
	-- 다시 아래로 20칸 이동
	for i = 1, 20 do
		lift.Position = lift.Position - Vector3.new(0, 1, 0)
		task.wait(0.05)
	end
	
	isMoving = false
end)
