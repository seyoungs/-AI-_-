local prompt = script.Parent:WaitForChild("ProximityPrompt")
local price = 100 -- 아이템 구매에 필요한 가격

prompt.Triggered:Connect(function(player)
	-- 플레이어의 leaderstats와 Money 데이터를 안전하게 가져옴
	local leaderstats = player:FindFirstChild("leaderstats")
	local money = leaderstats:FindFirstChild("Money")
	
	-- 플레이어가 가진 돈이 가격보다 많거나 같을 때만 실행
	if money.Value >= price then
		money.Value = money.Value - price -- 보유한 돈에서 가격만큼 차감
		
		-- ServerStorage에 있는 Tool1을 복사해서 플레이어 가방(Backpack)으로 지급
		local tool = game.ServerStorage.Tool1:Clone()
		tool.Parent = player.Backpack
	end
end)
